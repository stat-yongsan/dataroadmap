# 이름만 적는다 — 값은 D:\devOps\.env(비밀값 한 곳)에 넣는다. 이 파일에는 절대 값을 쓰지 않는다.
# 키가 있으면 계획을 만들 때 LIVE 판단을 켤 수 있다(기본은 MOCK). 키 값은 화면 · 로그 · 내려받기 파일에 나오지 않는다.
TYPESAFE_API_KEY=
# 비우면 jev-latest
JEV_MODEL=
# 비우면 공식 주소 https://api.typesafe.ai/v1/systemone
JEV_API_URL=
# OpenAI Decisions API 판단 — 키가 있어야 「판단」에서 고를 수 있다(저절로 켜지지 않음). stat.yongsan 계정 키만 쓴다
OPENAI_API_KEY=
# 비우면 gpt-6-luna(공식 문서상 유일한 지원 모델)
OPENAI_DECISIONS_MODEL=
# 비우면 공식 주소 https://api.openai.com/v1/decisions
OPENAI_DECISIONS_URL=
# 비우면 D:\elec5_test\Excel_Automation_Playbook_KO.md
PLAYBOOK_PATH=
# 결정 속도 비교(/race)의 Opus 5.5 호출용 — 없으면 그 화면의 Opus 쪽만 꺼진다
ANTHROPIC_API_KEY=
